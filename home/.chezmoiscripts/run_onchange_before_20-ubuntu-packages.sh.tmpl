{{- /* Ubuntu, Debian and Raspberry Pi OS share the one apt list */ -}}
{{ if or (eq .distro "ubuntu") (eq .distro "debian") -}}
#!/bin/bash
# Installs apt packages from .chezmoidata/packages.yaml. Reruns when that list changes.
set -euo pipefail
echo "==> Installing apt packages"

pkgs=(
{{- range .packages.ubuntu.apt }}
  {{ . | quote }}
{{- end }}
)
sudo apt-get update
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${pkgs[@]}"
{{ end -}}
