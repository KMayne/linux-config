{{ if eq .distro "fedora" -}}
#!/bin/bash
# Adds third-party package repos. Reruns whenever this script or the COPR list changes.
set -euo pipefail
echo "==> Adding package repos"

sudo dnf install -y 'dnf-command(copr)'
{{ range .packages.fedora.copr -}}
sudo dnf copr enable -y {{ . | quote }}
{{ end }}
sudo tee /etc/yum.repos.d/vscode.repo >/dev/null <<'REPO'
[code]
name=Visual Studio Code
baseurl=https://packages.microsoft.com/yumrepos/vscode
enabled=1
autorefresh=1
type=rpm-md
gpgcheck=1
gpgkey=https://packages.microsoft.com/keys/microsoft.asc
REPO

sudo tee /etc/yum.repos.d/tailscale.repo >/dev/null <<'REPO'
[tailscale-stable]
name=Tailscale stable
baseurl=https://pkgs.tailscale.com/stable/fedora/$basearch
enabled=1
type=rpm
repo_gpgcheck=1
gpgcheck=1
gpgkey=https://pkgs.tailscale.com/stable/fedora/repo.gpg
REPO
{{- if eq .chezmoi.arch "amd64" }}

sudo tee /etc/yum.repos.d/google-chrome.repo >/dev/null <<'REPO'
[google-chrome]
name=google-chrome
baseurl=https://dl.google.com/linux/chrome/rpm/stable/x86_64
enabled=1
gpgcheck=1
gpgkey=https://dl.google.com/linux/linux_signing_key.pub
REPO
{{- if not (get . "minimal") }}

# MEGA's own repo (mega.nz/linux/repo); megasync is in packages.yaml dnf_x86_64_not_minimal
sudo tee /etc/yum.repos.d/megasync.repo >/dev/null <<'REPO'
[MEGAsync]
name=MEGAsync
baseurl=https://mega.nz/linux/repo/Fedora_$releasever/
enabled=1
gpgcheck=1
gpgkey=https://mega.nz/linux/repo/Fedora_$releasever/repodata/repomd.xml.key
REPO
{{- end }}
{{- end }}

{{- if .asus }}

# Terra hosts the asus-linux packages; terra-release brings its GPG key and terra.repo.
# Skip once installed: the temporary repo id would clash with terra.repo's [terra] on reruns.
rpm -q terra-release >/dev/null 2>&1 ||
  sudo dnf install -y --nogpgcheck --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' terra-release
{{- end }}

{{- if .kde }}

sudo dnf install -y flatpak
sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
{{- end }}
{{ end -}}
