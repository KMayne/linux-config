{{ if eq .distro "fedora" -}}
#!/bin/bash
# Installs dnf packages from .chezmoidata/packages.yaml. Reruns when that list changes.
set -euo pipefail
echo "==> Installing dnf packages"

pkgs=(
{{- range .packages.fedora.dnf }}
  {{ . | quote }}
{{- end }}
{{- if eq .chezmoi.arch "amd64" }}
{{- range .packages.fedora.dnf_x86_64 }}
  {{ . | quote }}
{{- end }}
{{- end }}
{{- if .kde }}
{{- range .packages.fedora.dnf_kde }}
  {{ . | quote }}
{{- end }}
{{- end }}
{{- if .asus }}
{{- range .packages.fedora.dnf_asus }}
  {{ . | quote }}
{{- end }}
{{- end }}
)
sudo dnf install -y "${pkgs[@]}"
{{- if eq .chezmoi.arch "amd64" }}

# Offer the Bitwarden extension in Chrome; it asks to enable it on next launch
sudo install -d /usr/share/google-chrome/extensions
echo '{"external_update_url": "https://clients2.google.com/service/update2/crx"}' |
  sudo tee /usr/share/google-chrome/extensions/nngceckbapebfimnlniiiahkandclblb.json >/dev/null
{{- end }}
{{ end -}}
