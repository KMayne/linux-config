{{ if and (eq .distro "fedora") .kde -}}
#!/bin/bash
# Installs Flatpaks from .chezmoidata/packages.yaml (desktop machines only). Reruns when that list changes.
set -euo pipefail
echo "==> Installing Flatpaks"

apps=(
{{- range .packages.fedora.flatpak }}
  {{ . | quote }}
{{- end }}
{{- if not (get . "minimal") }}
{{- range .packages.fedora.flatpak_not_minimal }}
  {{ . | quote }}
{{- end }}
{{- end }}
)
sudo flatpak install -y --noninteractive flathub "${apps[@]}"
{{ end -}}
